<!--
 File: backend/src/Nabz.Database.EF.Sql/Nabz.Database.EF.Sql.csproj
 Description: لایه EF؛ پچ EF 10.0.15 و pin Cryptography برای رفع NU190
 Parent Dependencies: Nabz.Domain, Nabz.Application
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nabz.Domain\Nabz.Domain.csproj" />
    <ProjectReference Include="..\Nabz.Application\Nabz.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <!-- Pin ترنزیتیو آسیب‌پذیر از SqlClient / EF.Design تا NU1902/NU1903 پاک شود -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
